#!/usr/bin/env python3
"""Report and compare ELF section sizes using GNU-compatible `size -A`."""

import argparse
import json
import os
import shlex
import subprocess
import sys
from pathlib import Path


SECTION_GROUPS = {
    "text": (".text", ".iram", ".flash.text"),
    "rodata": (".rodata", ".srodata", ".flash.rodata"),
    "data": (".data", ".sdata"),
    "bss": (".bss", ".sbss"),
}


def classify(section):
    if section.startswith(SECTION_GROUPS["text"]):
        return "text"
    if section.startswith(SECTION_GROUPS["rodata"]):
        return "rodata"
    if section.startswith(SECTION_GROUPS["data"]) or section.endswith(SECTION_GROUPS["data"]):
        return "data"
    if section.startswith(SECTION_GROUPS["bss"]) or section.endswith(SECTION_GROUPS["bss"]):
        return "bss"
    return None


def get_sizes(elf):
    command = shlex.split(os.environ.get("SIZE", "size")) + ["-A", str(elf)]
    result = subprocess.run(command, check=True, text=True, capture_output=True)
    sizes = {group: 0 for group in SECTION_GROUPS}
    sections = {}
    for line in result.stdout.splitlines():
        fields = line.split()
        if len(fields) < 2 or not fields[0].startswith("."):
            continue
        try:
            section_size = int(fields[1], 0)
        except ValueError:
            continue
        sections[fields[0]] = section_size
        group = classify(fields[0])
        if group:
            sizes[group] += section_size
    if not sections:
        raise ValueError(f"`size -A` returned no ELF sections for {elf}")
    sizes["total"] = sum(sizes.values())
    return sizes, sections


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("elf", type=Path, help="firmware ELF file")
    parser.add_argument("--compare", type=Path, help="previous report JSON")
    parser.add_argument("--output", type=Path, help="write report JSON to this path")
    args = parser.parse_args()
    if not args.elf.is_file():
        parser.error(f"ELF file does not exist: {args.elf}")

    try:
        sizes, sections = get_sizes(args.elf)
        report = {
            "schema_version": 1,
            "elf": str(args.elf),
            "bytes": sizes,
            "sections": sections,
        }
        if args.compare:
            previous = json.loads(args.compare.read_text(encoding="utf-8"))
            report["comparison_bytes"] = {
                key: sizes[key] - previous["bytes"][key]
                for key in sizes
            }
        serialized = json.dumps(report, indent=2, sort_keys=True) + "\n"
        if args.output:
            args.output.write_text(serialized, encoding="utf-8")
        sys.stdout.write(serialized)
    except (OSError, subprocess.CalledProcessError, ValueError, KeyError) as error:
        parser.exit(1, f"size-report: {error}\n")


if __name__ == "__main__":
    main()
